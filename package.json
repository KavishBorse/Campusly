{
  "name": "campusly",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace backend\" \"npm:dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "check": "npm run check --workspace backend && npm run check --workspace frontend",
    "test": "npm run test --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
