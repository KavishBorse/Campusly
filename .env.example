NODE_ENV=development
PORT=4001
FRONTEND_ORIGIN=http://localhost:5173
# Docker Compose publishes these ports on localhost only. MongoDB defaults to 27019
# so it can coexist with local MongoDB services using 27017 or 27018.
WEB_HOST_PORT=5173
API_HOST_PORT=4001
MONGODB_HOST_PORT=27019
MONGODB_URI=mongodb://127.0.0.1:27017/campusly
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used only by `npm run seed --workspace backend` in development. Use local demo values.
SEED_ADMIN_USERNAME=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_STUDENT_ENROLLMENT=
SEED_STUDENT_NAME=
SEED_STUDENT_PHONE=
# Optional development club account
SEED_CLUB_USERNAME=
SEED_CLUB_PASSWORD=
SEED_CLUB_NAME=
